@* Editing one pump entry after the fact: the times, the amount, the note.
   A stock correction is a moment and a figure, so it shows neither an end time nor a duration. *@

<div class="sheet-backdrop" @onclick="() => OnCancel.InvokeAsync()">
    <div class="sheet" @onclick:stopPropagation="true">
        <h2>
            <span class="ico @(IsStockSet ? "" : "breast")"><Icon Name="@(IsStockSet ? "pencil" : "pump")" /></span>
            @(IsNew ? "Add a session" : IsStockSet ? "Stock correction" : "Edit session")
        </h2>

        <TimeField Id="pump-start" Label="@(IsStockSet ? "Counted at" : "Started")"
                   Value="@startText" ValueChanged="v => startText = v" />

        @if (!IsStockSet)
        {
            <TimeField Id="pump-end" Label="Stopped"
                       Value="@endText" ValueChanged="v => endText = v"
                       ClearLabel="Still pumping" Hint="@DurationHint" />
        }

        @if (!IsStockSet && TimeField.Parse(endText) is not null)
        {
            @* Its own fact, the same as the feeding time on a feed: a session that was paused did
               not last the stretch between its start and its stop, so moving the stop must change
               the pause rather than how long was actually spent pumping. *@
            <div class="field">
                <label for="pump-time">Pumping time (minutes)</label>
                <input id="pump-time" type="number" inputmode="numeric" min="0" max="600" step="1"
                       @bind="pumpMinutes" @bind:event="oninput" />
                <div class="hint-line">@PumpingHint</div>
            </div>
        }

        @if (!IsStockSet)
        {
            <div class="field">
                <label>Which batch?</label>
                <div class="choice">
                    <button type="button" class="@(batch == MilkTime.Morning ? "on" : "")"
                            @onclick="() => batch = batch == MilkTime.Morning ? null : MilkTime.Morning">Morning milk</button>
                    <button type="button" class="@(batch == MilkTime.Night ? "on" : "")"
                            @onclick="() => batch = batch == MilkTime.Night ? null : MilkTime.Night">Night milk</button>
                </div>
            </div>
        }

        <div class="field">
            <label for="pump-amount">@(IsStockSet ? "Stock at that moment (ml)" : "Pumped (ml)")</label>
            <input id="pump-amount" type="number" inputmode="numeric" min="0" max="2000" step="5" @bind="amount" />

            @if (IsStockSet)
            {
                <div class="hint-line">
                    Everything before this stops counting: the stock is worked out forwards from here.
                </div>
            }
        </div>

        <div class="field">
            <label for="pump-notes">Notes</label>
            <input id="pump-notes" type="text" maxlength="500" @bind="notes" />
        </div>

        @if (confirmDelete)
        {
            <div class="row-btns">
                <button type="button" class="btn" @onclick="() => confirmDelete = false">Keep</button>
                <button type="button" class="btn danger" @onclick="() => OnDelete.InvokeAsync(Entry.Id)">Delete for good</button>
            </div>
        }
        else
        {
            <div class="row-btns">
                @if (!IsNew)
                {
                    <button type="button" class="btn danger" @onclick="() => confirmDelete = true">Delete</button>
                }
                <button type="button" class="btn" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
                <button type="button" class="btn primary" @onclick="Save">Save</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PumpEntry Entry { get; set; } = default!;

    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public EventCallback<PumpEntry> OnSave { get; set; }

    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private string startText = "";
    private string endText = "";
    private int? amount;
    private MilkTime? batch;
    private int pumpMinutes;
    private int initialPumpMinutes;
    private string? notes;
    private bool confirmDelete;
    private int loadedId = -1;

    private bool IsNew => Entry.Id == 0;

    private bool IsStockSet => Entry.Kind == PumpEntryKind.StockSet;

    private string DurationHint
    {
        get
        {
            var start = TimeField.Parse(startText);
            var end = TimeField.Parse(endText);

            if (start is null)
            {
                return "";
            }

            if (end is null)
            {
                return "Still pumping — no stop time yet.";
            }

            return end <= start
                ? "The stop time is before the start."
                : $"{Display.Duration(end.Value - start.Value)} from start to stop.";
        }
    }

    protected override void OnParametersSet()
    {
        // Only when a different entry arrives: re-reading on every render would undo whatever
        // has just been typed.
        if (loadedId == Entry.Id)
        {
            return;
        }

        loadedId = Entry.Id;
        startText = TimeField.ToText(Display.ToLocal(Entry.StartUtc));
        endText = Entry.EndUtc is null ? "" : TimeField.ToText(Display.ToLocal(Entry.EndUtc.Value));
        amount = Entry.AmountMl;
        batch = Entry.MilkTime;

        initialPumpMinutes = (int)Math.Round(
            (Entry.Duration ?? Entry.ElapsedAt(DateTime.UtcNow)).TotalMinutes);
        pumpMinutes = initialPumpMinutes;

        notes = Entry.Notes;
        confirmDelete = false;
    }

    private Task Save()
    {
        var start = TimeField.Parse(startText) ?? Display.ToLocal(Entry.StartUtc);
        var end = IsStockSet ? null : TimeField.Parse(endText);

        // A stop time before the start would give a negative duration and a nonsense total, so
        // it is dropped rather than saved — the entry goes back to running and can be stopped
        // again properly.
        if (end is not null && end <= start)
        {
            end = null;
        }

        var updated = new PumpEntry
        {
            Id = Entry.Id,
            BabyId = Entry.BabyId,
            Kind = Entry.Kind,
            StartUtc = Display.ToUtc(start),
            EndUtc = end is null ? null : Display.ToUtc(end.Value),
            AmountMl = amount,

            // A correction row keeps the side it was written for; only a session is re-labelled.
            MilkTime = IsStockSet ? Entry.MilkTime : batch,
            Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim()
        };

        ApplyPause(updated);

        return OnSave.InvokeAsync(updated);
    }

    /// <summary>
    /// stop − start = pumping + paused, with the pumping time held fixed. See the same note on
    /// EditEventDialog, which does this for the two sorts of feed.
    /// </summary>
    private void ApplyPause(PumpEntry updated)
    {
        if (IsStockSet || updated.EndUtc is not { } end)
        {
            updated.PausedSeconds = Entry.PausedSeconds;
            updated.PausedAtUtc = Entry.PausedAtUtc;
            return;
        }

        var window = end - updated.StartUtc;

        var pumping = pumpMinutes == initialPumpMinutes && Entry.Duration is { } recorded
            ? recorded
            : TimeSpan.FromMinutes(Math.Max(0, pumpMinutes));

        updated.PausedSeconds = BabyEvent.PausedSecondsFor(window, pumping);
        updated.PausedAtUtc = null;
    }

    private string PumpingHint
    {
        get
        {
            var start = TimeField.Parse(startText);
            var end = TimeField.Parse(endText);

            if (start is null || end is null)
            {
                return "";
            }

            var window = end.Value - start.Value;
            if (window < TimeSpan.Zero)
            {
                return "The stop is before the start.";
            }

            var pumping = TimeSpan.FromMinutes(Math.Max(0, pumpMinutes));

            if (pumping > window)
            {
                return $"Longer than the {Display.Duration(window)} between the start and the stop, "
                       + $"so it will be saved as {Display.Duration(window)}.";
            }

            var paused = window - pumping;
            return paused > TimeSpan.Zero
                ? $"Leaves {Display.Duration(paused)} of that window as paused."
                : "The whole window counts as pumping.";
        }
    }
}
