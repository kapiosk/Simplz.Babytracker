<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Simplz.Babytracker.styles.css"]" />
    <ImportMap />

    <title>Baby Tracker</title>
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#6b4ee6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14121b" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Baby" />
    <link rel="icon" type="image/png" href="icons/icon-192.png" />
    <link rel="apple-touch-icon" href="icons/icon-192.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />

    @* Shown by circuit-watchdog.js when the page has lost the server without noticing. *@
    <div id="circuit-banner" data-nosnippet hidden>
        <span class="msg"></span>
        <button type="button" data-reload>Reload</button>
    </div>

    @* autostart="false": circuit-watchdog.js starts Blazor itself, with a reconnect that
       keeps trying instead of giving up after half a minute. *@
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="@Assets["circuit-watchdog.js"]"></script>
    <script src="service-worker-register.js"></script>
</body>

</html>
