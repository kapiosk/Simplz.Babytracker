@inherits LayoutComponentBase
@inject BabyService Babies

<header class="app-header">
    <div>
        <div class="title">Baby Tracker</div>
        <div class="sub">@DateTime.Now.ToString("dddd d MMMM")</div>
    </div>

    <div class="header-actions">
        <AuthorizeView>
            <Authorized>
                <NavLink class="icon-btn" href="babies" title="Babies" aria-label="Babies">
                    <span class="ico"><Icon Name="baby" /></span>
                </NavLink>
            </Authorized>
        </AuthorizeView>

        @* Deliberately not a Blazor @onclick: this button is here for the times the circuit
           that would carry that click is the thing that is broken. wwwroot/circuit-watchdog.js
           handles data-reload in plain JavaScript. *@
        <button type="button" class="icon-btn" data-reload
                title="Reload the page" aria-label="Reload the page">
            <span class="ico"><Icon Name="refresh" /></span>
        </button>

        <AuthorizeView>
            <Authorized>
                <form class="who" action="logout" method="post">
                    <AntiforgeryToken />
                    @if (!context.User.IsInRole(Roles.Parent))
                    {
                        <span class="role ro" title="This password cannot change anything">Read only</span>
                    }
                    <button type="submit" class="link-btn">Sign out</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

@* One baby needs no switcher, and the buttons below are worth more than a row saying so. *@
@if (babies.Count > 1)
{
    <AuthorizeView>
        <Authorized>
            <form class="baby-switch" action="baby" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@Here()" />
                @foreach (var baby in babies)
                {
                    <button type="submit" name="babyId" value="@baby.Id"
                            class="chip @(baby.Id == selected?.Id ? "on" : "")">
                        @baby.Name
                    </button>
                }
            </form>
        </Authorized>
    </AuthorizeView>
}

@* Rendered hidden; wwwroot/whats-new.js shows it unless this phone has read this version. *@
<AuthorizeView>
    <Authorized>
        <div id="whats-new" data-version="@Changelog.Current.Version" hidden>
            <span class="msg">Updated to @Changelog.Current.Version</span>
            <a href="whats-new">What's new</a>
            <button type="button" data-dismiss title="Dismiss" aria-label="Dismiss">🗙</button>
        </div>
    </Authorized>
</AuthorizeView>

<main class="app-main">
    @Body
</main>

<nav class="app-nav">
    <NavLink href="" Match="NavLinkMatch.All">
        <span class="ico"><Icon Name="timer" /></span>
        Track
    </NavLink>
    <NavLink href="chart">
        <span class="ico"><Icon Name="table" /></span>
        Chart
    </NavLink>
    <NavLink href="report">
        <span class="ico"><Icon Name="chart" /></span>
        Report
    </NavLink>
</nav>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private List<Baby> babies = [];
    private Baby? selected;

    protected override async Task OnInitializedAsync()
    {
        babies = await Babies.ListAsync();
        selected = await Babies.SelectedAsync(AuthState);
    }

    /// <summary>Where to come back to after switching, so the tap does not also lose your place.</summary>
    private string Here()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        return string.IsNullOrEmpty(path) ? "/" : "/" + path;
    }
}
