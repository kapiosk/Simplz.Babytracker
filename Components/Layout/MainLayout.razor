@inherits LayoutComponentBase

<header class="app-header">
    <div>
        <div class="title">Baby Tracker</div>
        <div class="sub">@DateTime.Now.ToString("dddd d MMMM")</div>
    </div>

    <div class="header-actions">
        @* Deliberately not a Blazor @@onclick: this button is here for the times the circuit
           that would carry that click is the thing that is broken. wwwroot/circuit-watchdog.js
           handles data-reload in plain JavaScript. *@
        <button type="button" class="icon-btn" data-reload
                title="Reload the page" aria-label="Reload the page">
            <span class="ico"><Icon Name="refresh" /></span>
        </button>

        <AuthorizeView>
            <Authorized>
                <form class="who" action="logout" method="post">
                    <AntiforgeryToken />
                    @if (!context.User.IsInRole(Roles.Parent))
                    {
                        <span class="role ro" title="This password cannot change anything">Read only</span>
                    }
                    <button type="submit" class="link-btn">Sign out</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

<main class="app-main">
    @Body
</main>

<nav class="app-nav">
    <NavLink href="" Match="NavLinkMatch.All">
        <span class="ico"><Icon Name="timer" /></span>
        Track
    </NavLink>
    <NavLink href="chart">
        <span class="ico"><Icon Name="table" /></span>
        Chart
    </NavLink>
    <NavLink href="report">
        <span class="ico"><Icon Name="chart" /></span>
        Report
    </NavLink>
</nav>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
