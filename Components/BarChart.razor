@* One measure over one range: a title, the total, and a bar per bucket.

   Plain HTML rather than SVG. Bars are rectangles, and a flex row of divs already is one — no
   viewBox arithmetic, no rounded corners stretched out of shape when the phone turns, and the
   colours come from the theme's own variables so light and dark both work for nothing.

   Deliberately one measure per chart. Sleep is in hours and bottles are in millilitres, and two
   scales on one axis is the surest way to draw something that looks like a fact and is not one.

   The chart's own title carries which measure it is, so the colour never has to. That matters
   here: the palette has a pair that reads as close to a colourblind eye, and titling every chart
   is what makes that harmless rather than something to guess at. *@

<div class="card chart-card">
    <div class="chart-head">
        <span class="k"><span class="ico @Css"><Icon Name="@IconName" /></span> @Label</span>
        <span class="v">@Total</span>
    </div>

    @if (peak <= 0)
    {
        <div class="chart-empty">Nothing recorded in this range.</div>
    }
    else
    {
        <div class="bars @Css" role="img" aria-label="@Description()">
            @for (var i = 0; i < Points.Count; i++)
            {
                var point = Points[i];

                <div class="bar-slot" title="@point.Label: @point.Text">
                    @if (!LabelEvery && i == peakIndex)
                    {
                        @* When there are too many to label, the tallest still carries a number
                           so the scale is not a mystery. The rest are in the list underneath. *@
                        <span class="bar-peak">@point.Text</span>
                    }
                    <div class="bar" style="height:@Height(point.Value)"></div>
                </div>
            }
        </div>

        @if (LabelEvery)
        {
            @* A parallel row rather than a footer inside each slot: the bars are sized as a
               percentage of their slot, so putting anything in there would shorten them.
               Same flex basis and same gap, so the columns line up. *@
            <div class="bar-feet">
                @foreach (var point in Points)
                {
                    <span class="foot">
                        <span class="l">@point.Label</span>
                        <span class="v">@point.Compact</span>
                    </span>
                }
            </div>

            @if (HasDetails)
            {
                @* With every bar labelled there is no list to open, so the entries get one of
                   their own. Same plain <details>, for the same reasons as the one below. *@
                <details class="chart-numbers">
                    <summary>@DetailsTitle</summary>
                    <div class="numbers wide">
                        @foreach (var point in Points.Where(p => p.Detail is not null))
                        {
                            <span><b>@point.Label</b> @point.Detail</span>
                        }
                    </div>
                </details>
            }
        }
        else
        {
            <div class="chart-axis">
                <span>@Points[0].Label</span>
                @if (Points.Count > 1)
                {
                    <span>@Points[^1].Label</span>
                }
            </div>

            @* Plain <details>, deliberately: no @onclick, so opening it costs no round trip and
               works with the circuit down — the same reasoning as the reload button. *@
            <details class="chart-numbers">
                <summary>Every @Bucket</summary>
                <div class="numbers @(HasDetails ? "wide" : "")">
                    @foreach (var point in Points)
                    {
                        <span><b>@point.Label</b> @point.Listed@(point.Detail is { } d ? $" · {d}" : "")</span>
                    }
                </div>
            </details>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>The kind's colour class — breast, bottle, poop, sleep.</summary>
    [Parameter, EditorRequired] public string Css { get; set; } = "";

    [Parameter, EditorRequired] public string IconName { get; set; } = "";

    /// <summary>The whole range in one figure, which is the number worth reading first.</summary>
    [Parameter, EditorRequired] public string Total { get; set; } = "";

    /// <summary>What one bar covers — "day" or "hour" — for the description a screen reader gets.</summary>
    [Parameter] public string Bucket { get; set; } = "day";

    [Parameter, EditorRequired] public IReadOnlyList<Point> Points { get; set; } = [];

    /// <summary>
    /// What to call the list of the entries behind each bar — "Each session" — when the points
    /// carry one. Left unset, a bar is only ever its total.
    /// </summary>
    [Parameter] public string? DetailsTitle { get; set; }

    private bool HasDetails => DetailsTitle is not null && Points.Any(p => p.Detail is not null);

    /// <summary>
    /// Up to this many bars, every one carries its own figure under it. Past it there is not
    /// the width, and the list underneath is what answers "what was that one worth".
    /// </summary>
    public const int LabelEveryUpTo = 8;

    private bool LabelEvery => Points.Count <= LabelEveryUpTo;

    private double peak;
    private int peakIndex = -1;

    /// <summary>
    /// What a screen reader is told in place of the drawing. Every bucket and its figure, since
    /// "sleep by day, 32h in total" describes the shape of the thing without saying anything
    /// that is in it.
    /// </summary>
    private string Description() =>
        $"{Label} by {Bucket}, {Total} in total. "
        + string.Join(". ", Points.Select(p => $"{p.Label}, {p.Text}"));

    protected override void OnParametersSet()
    {
        peak = 0;
        peakIndex = -1;

        for (var i = 0; i < Points.Count; i++)
        {
            if (Points[i].Value > peak)
            {
                peak = Points[i].Value;
                peakIndex = i;
            }
        }
    }

    private string Height(double value) =>
        value <= 0
            ? "0"
            : $"{Math.Max(2, Math.Round(value / peak * 100, 2)).ToString(System.Globalization.CultureInfo.InvariantCulture)}%";

    /// <summary>One bar: what it covers, how tall, and how to say it.</summary>
    /// <param name="Text">The full reading — "12h 20m", "5 feeds", "450 ml".</param>
    /// <param name="Short">
    /// The same figure with the unit dropped, for under a bar where there is no room for it.
    /// The chart is titled, so a bare number there is not ambiguous. Optional: where the full
    /// reading is already short enough, leave it and both are the same.
    /// </param>
    /// <param name="Detail">
    /// The entries the bar adds up — "07:10 20m · 13:40 25m" — for the list that opens them,
    /// where a total alone does not answer when. Optional, and only shown under a chart that
    /// names its list.
    /// </param>
    public sealed record Point(string Label, double Value, string Text, string? Short = null, string? Detail = null)
    {
        /// <summary>What goes under a bar. A dash for nothing: "0 feeds" seven times over
        /// reads like a fault, where a row of dashes reads as the quiet week it was.</summary>
        public string Compact => Value <= 0 ? "–" : Short ?? Text;

        /// <summary>
        /// What goes in the full list, where there is room for the unit. Still a dash for
        /// nothing — in thirty days of which twenty are empty, "none" twenty times buries the
        /// ten readings that are the reason for opening it.
        /// </summary>
        public string Listed => Value <= 0 ? "–" : Text;
    }
}
