@implements IDisposable

@if (Events.Count == 0)
{
    <div class="empty">@EmptyText</div>
}
else
{
    <ul class="events">
        @foreach (var e in Events)
        {
            <li class="event" @key="e.Id">
                <span class="ico @Display.Css(e.Kind)"><Icon Name="@Icon.For(e.Kind)" /></span>
                <div class="body">
                    <div class="name">@Display.Label(e)</div>
                    <div class="meta">@Meta(e)</div>
                    @if (!string.IsNullOrWhiteSpace(e.Notes))
                    {
                        <div class="notes">@e.Notes</div>
                    }

                    @* Shown to the read-only password too: a doctor being able to look at the
                       photograph is most of the reason for taking one. *@
                    @if (media.TryGetValue(e.Id, out var attached) && attached.Count > 0)
                    {
                        <div class="media-strip small">
                            @foreach (var item in attached)
                            {
                                <a class="media-item" href="@($"/media/{item.Id}")" target="_blank" rel="noopener" @key="item.Id">
                                    @if (item.IsVideo)
                                    {
                                        <video src="@($"/media/{item.Id}")" preload="metadata" muted></video>
                                    }
                                    else
                                    {
                                        <img src="@($"/media/{item.Id}")" alt="attachment" loading="lazy" />
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
                @if (CanEdit)
                {
                    <button class="icon-btn" title="Edit" aria-label="Edit @Display.Label(e)"
                            @onclick="() => OnEdit.InvokeAsync(e)"><Icon Name="pencil" /></button>
                }
            </li>
        }
    </ul>
}

@code {
    [Inject] private MediaService Media { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyList<BabyEvent> Events { get; set; } = [];
    [Parameter] public EventCallback<BabyEvent> OnEdit { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool ShowDate { get; set; }
    [Parameter] public string EmptyText { get; set; } = "Nothing logged yet.";

    private Dictionary<int, List<EventMedia>> media = [];
    private string loadedFor = "";

    protected override async Task OnParametersSetAsync()
    {
        // Only when the entries on show actually change, not on every re-render.
        var signature = string.Join(',', Events.Select(e => e.Id));
        if (signature == loadedFor)
        {
            return;
        }

        loadedFor = signature;
        await LoadMediaAsync();
    }

    protected override void OnInitialized() => Media.Changed += OnMediaChanged;

    private void OnMediaChanged(int eventId) => _ = InvokeAsync(async () =>
    {
        if (Events.Any(e => e.Id == eventId))
        {
            await LoadMediaAsync();
            StateHasChanged();
        }
    });

    private async Task LoadMediaAsync()
    {
        var ids = Events.Select(e => e.Id).ToList();
        media = ids.Count == 0 ? [] : await Media.ForEventsAsync(ids);
    }

    public void Dispose() => Media.Changed -= OnMediaChanged;

    private string Meta(BabyEvent e)
    {
        var local = Display.ToLocal(e.StartUtc);
        var when = ShowDate ? local.ToString("ddd d MMM, HH:mm") : $"{local:HH:mm} · {Display.Ago(e.StartUtc)}";

        var extra = e.Kind switch
        {
            EventKind.BreastFeed when e.EndUtc is null => "still feeding",
            EventKind.BreastFeed => Display.Duration(e.Duration!.Value),
            EventKind.BottleFeed when e.AmountMl is > 0 => $"{e.AmountMl} ml",
            _ => null
        };

        return extra is null ? when : $"{when} · {extra}";
    }
}
