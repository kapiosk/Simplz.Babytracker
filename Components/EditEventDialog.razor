<div class="sheet-backdrop" @onclick="() => OnCancel.InvokeAsync()">
    <div class="sheet" @onclick:stopPropagation="true">
        <h2><span class="ico @Display.Css(kind)"><Icon Name="@Icon.For(kind)" /></span> @(IsNew ? "Add entry" : "Edit entry")</h2>

        <div class="field">
            <label>Type</label>
            <div class="kinds">
                @foreach (var k in Enum.GetValues<EventKind>())
                {
                    <button type="button" class="kind @Display.Css(k) @(kind == k ? "on" : "")" @onclick="() => kind = k">
                        <span class="ico @Display.Css(k)"><Icon Name="@Icon.For(k)" /></span>
                        @Display.Label(k)
                    </button>
                }
            </div>
        </div>

        <TimeField Id="start" Label="@(BabyEvent.Lasts(kind) ? "Started" : "Time")"
                   Value="@startText" ValueChanged="v => startText = v" />

        @if (BabyEvent.Lasts(kind))
        {
            <TimeField Id="end" Label="@(kind == EventKind.Sleep ? "Woke" : "Stopped")"
                       Value="@endText" ValueChanged="v => endText = v"
                       ClearLabel="@(kind == EventKind.Sleep ? "Still asleep" : "Still feeding")"
                       Hint="@DurationHint" />
        }

        @if (BabyEvent.CanPause(kind) && TimeField.Parse(endText) is not null)
        {
            @* Its own field because it is its own fact. A feed that was paused did not last the
               stretch between its start and its stop, so moving the stop time cannot be allowed
               to decide how long the baby fed for — that difference belongs to the pause. *@
            <div class="field">
                <label for="edit-feeding">Feeding time (minutes)</label>
                <input id="edit-feeding" type="number" inputmode="numeric" min="0" max="600" step="1"
                       @bind="feedMinutes" @bind:event="oninput" />
                <div class="hint-line">@FeedingHint</div>
            </div>
        }

        @if (kind == EventKind.BottleFeed)
        {
            <div class="field">
                <label>What's in the bottle?</label>
                <div class="choice">
                    <button type="button" class="@(milk == MilkKind.BreastMilk ? "on" : "")"
                            @onclick="() => milk = MilkKind.BreastMilk">Breast milk</button>
                    <button type="button" class="@(milk == MilkKind.Formula ? "on" : "")"
                            @onclick="() => milk = MilkKind.Formula">Formula</button>
                </div>
            </div>

            <div class="field">
                <label for="edit-amount">Amount (ml)</label>
                <input id="edit-amount" type="number" inputmode="numeric" min="0" max="1000" step="5" @bind="amount" />
            </div>
        }

        <div class="field">
            <label for="edit-notes">Notes</label>
            <input id="edit-notes" type="text" maxlength="500" @bind="notes" />
        </div>

        <div class="field">
            <label>Photos and clips</label>

            @if (IsNew)
            {
                <div class="hint-line">Save the entry first, then reopen it to attach anything.</div>
            }
            else
            {
                @if (media.Count > 0)
                {
                    <div class="media-strip">
                        @foreach (var item in media)
                        {
                            <div class="media-item" @key="item.Id">
                                <a href="@($"/media/{item.Id}")" target="_blank" rel="noopener">
                                    @if (item.IsVideo)
                                    {
                                        <video src="@($"/media/{item.Id}")" preload="metadata" muted></video>
                                    }
                                    else
                                    {
                                        <img src="@($"/media/{item.Id}")" alt="@(item.OriginalName ?? "attachment")" loading="lazy" />
                                    }
                                </a>

                                @if (CanEdit)
                                {
                                    <button type="button" class="media-remove" title="Remove"
                                            @onclick="() => RemoveMedia(item.Id)"><Icon Name="close" /></button>
                                }
                            </div>
                        }
                    </div>
                }

                @if (CanEdit)
                {
                    <AntiforgeryToken />
                    <input id="@fileInputId" class="file-input" type="file" multiple
                           accept="image/*,video/*" @onchange="Upload" disabled="@uploading" />

                    <div class="hint-line">
                        @(uploading
                            ? "Uploading…"
                            : mediaMessage ?? "Up to 25 MB a photo, 200 MB a clip. Stored as they are — nothing is re-encoded.")
                    </div>
                }
                else if (media.Count == 0)
                {
                    <div class="hint-line">Nothing attached.</div>
                }
            }
        </div>

        @if (confirmDelete)
        {
            <div class="row-btns">
                <button type="button" class="btn" @onclick="() => confirmDelete = false">Keep</button>
                <button type="button" class="btn danger" @onclick="() => OnDelete.InvokeAsync(Event.Id)">Delete for good</button>
            </div>
        }
        else
        {
            <div class="row-btns">
                @if (!IsNew)
                {
                    <button type="button" class="btn danger" @onclick="() => confirmDelete = true">Delete</button>
                }
                <button type="button" class="btn" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
                <button type="button" class="btn primary" @onclick="Save">Save</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public BabyEvent Event { get; set; } = default!;

    /// <summary>The doctor password can look at what is attached, and nothing more.</summary>
    [Parameter] public bool CanEdit { get; set; } = true;

    [Inject] private MediaService Media { get; set; } = default!;

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<BabyEvent> OnSave { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private EventKind kind;
    private string startText = "";
    private string endText = "";
    private MilkKind milk = MilkKind.BreastMilk;
    private int? amount;
    private int feedMinutes;
    private int initialFeedMinutes;
    private string? notes;
    private bool confirmDelete;
    private int loadedId = -1;

    private List<EventMedia> media = [];
    private bool uploading;
    private string? mediaMessage;
    private readonly string fileInputId = $"attach-{Guid.NewGuid():N}";

    private bool IsNew => Event.Id == 0;

    private string DurationHint
    {
        get
        {
            var start = TimeField.Parse(startText);
            var end = TimeField.Parse(endText);

            if (start is null)
            {
                return "";
            }

            if (end is null)
            {
                return kind == EventKind.Sleep
                    ? "Still asleep — no waking time yet."
                    : "Still feeding — no stop time yet.";
            }

            var span = end.Value - start.Value;

            if (span < TimeSpan.Zero)
            {
                return "The end is before the start.";
            }

            // Only for the kinds that cannot pause is this also the duration. It used to say
            // "Duration" for everything, which was wrong the moment feeds could be paused: a
            // forty minute window with twenty of it paused was reported here as forty.
            return BabyEvent.CanPause(kind)
                ? $"{Display.Duration(span)} from start to stop"
                : $"Duration: {Display.Duration(span)}";
        }
    }

    protected override void OnParametersSet()
    {
        // Reload only when a different entry is opened, so the form is not reset mid-edit.
        if (Event.Id == loadedId && loadedId != -1)
        {
            return;
        }

        loadedId = Event.Id;
        kind = Event.Kind;
        startText = TimeField.ToText(Display.ToLocal(Event.StartUtc));
        endText = Event.EndUtc is null ? "" : TimeField.ToText(Display.ToLocal(Event.EndUtc.Value));
        milk = Event.Milk ?? MilkKind.BreastMilk;
        amount = Event.AmountMl;

        // Whole minutes for the box. A still-running entry has no recorded figure yet, so it
        // opens on what it has spent feeding so far.
        initialFeedMinutes = (int)Math.Round(
            (Event.Duration ?? Event.ElapsedAt(DateTime.UtcNow)).TotalMinutes);
        feedMinutes = initialFeedMinutes;

        notes = Event.Notes;
        confirmDelete = false;
        mediaMessage = null;
        media = [];

        if (Event.Id != 0)
        {
            _ = ReloadMediaAsync();
        }
    }

    private async Task ReloadMediaAsync()
    {
        var loaded = await Media.ForEventAsync(Event.Id);
        media = loaded;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Upload()
    {
        if (!CanEdit || Event.Id == 0)
        {
            return;
        }

        uploading = true;
        mediaMessage = null;

        try
        {
            var result = await JS.InvokeAsync<UploadResult>("babytrackerUpload", fileInputId, Event.Id);

            mediaMessage = result.Error is not null
                ? result.Error
                : result.Refused > 0
                    ? $"Added {result.Added}. {result.Refused} refused — too big, or not a photo or a clip."
                    : result.Added > 0 ? $"Added {result.Added}." : "Nothing was added.";

            await ReloadMediaAsync();
        }
        catch (Exception)
        {
            mediaMessage = "The upload did not finish.";
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task RemoveMedia(int id)
    {
        if (!CanEdit)
        {
            return;
        }

        await Media.DeleteAsync(id);
        mediaMessage = null;
        await ReloadMediaAsync();
    }

    private sealed record UploadResult(int Added, int Refused, string? Error);

    private Task Save()
    {
        var startLocal = TimeField.Parse(startText) ?? Display.ToLocal(Event.StartUtc);
        var endLocal = TimeField.Parse(endText);

        var updated = new BabyEvent
        {
            Id = Event.Id,
            Kind = kind,
            StartUtc = Display.ToUtc(startLocal),
            EndUtc = BabyEvent.Lasts(kind) && endLocal is not null ? Display.ToUtc(endLocal.Value) : null,
            Milk = kind == EventKind.BottleFeed ? milk : null,
            AmountMl = kind == EventKind.BottleFeed ? amount : null,
            Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim()
        };

        if (updated.EndUtc < updated.StartUtc)
        {
            updated.EndUtc = updated.StartUtc;
        }

        ApplyPause(updated);

        return OnSave.InvokeAsync(updated);
    }

    /// <summary>
    /// Start, stop and feeding time are three readings of two facts: the window is the stop minus
    /// the start, and whatever of that window was not feeding was paused.
    ///
    ///     stop − start  =  feeding  +  paused
    ///
    /// The feeding time is the one held fixed, so moving the stop changes the pause rather than
    /// rewriting how long the baby fed for. Typing a feeding time changes the pause too, from
    /// the other side. Only when the window is made shorter than the feeding time does the
    /// feeding time give — there is no fitting forty minutes of feeding into thirty.
    /// </summary>
    private void ApplyPause(BabyEvent updated)
    {
        if (!BabyEvent.CanPause(updated.Kind) || updated.EndUtc is not { } end)
        {
            // Nothing here can hold a pause, or it is still running and the figure is still
            // moving. Carry what was there rather than inventing one.
            updated.PausedSeconds = Event.PausedSeconds;
            updated.PausedAtUtc = Event.PausedAtUtc;
            return;
        }

        var window = end - updated.StartUtc;

        // An untouched box uses the stored figure exactly rather than the whole minutes it was
        // displayed as, so saving without touching it does not quietly shave off the seconds.
        var feeding = feedMinutes == initialFeedMinutes && Event.Duration is { } recorded
            ? recorded
            : TimeSpan.FromMinutes(Math.Max(0, feedMinutes));

        updated.PausedSeconds = BabyEvent.PausedSecondsFor(window, feeding);

        // A finished entry is never paused, whatever it was doing when the editor opened.
        updated.PausedAtUtc = null;
    }

    private string FeedingHint
    {
        get
        {
            var start = TimeField.Parse(startText);
            var end = TimeField.Parse(endText);

            if (start is null || end is null)
            {
                return "";
            }

            var window = end.Value - start.Value;
            if (window < TimeSpan.Zero)
            {
                return "The stop is before the start.";
            }

            var feeding = TimeSpan.FromMinutes(Math.Max(0, feedMinutes));

            if (feeding > window)
            {
                return $"Longer than the {Display.Duration(window)} between the start and the stop, "
                       + $"so it will be saved as {Display.Duration(window)}.";
            }

            var paused = window - feeding;
            return paused > TimeSpan.Zero
                ? $"Leaves {Display.Duration(paused)} of that window as paused."
                : "The whole window counts as feeding.";
        }
    }
}
