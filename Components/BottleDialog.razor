<div class="sheet-backdrop" @onclick="() => OnCancel.InvokeAsync()">
    <div class="sheet" @onclick:stopPropagation="true">
        <h2><span class="ico bottle"><Icon Name="bottle" /></span> @(Finishing ? "Finish the bottle" : "Bottle feed")</h2>

        @if (Finishing)
        {
            <div class="hint-line sheet-hint">@FinishHint</div>
        }

        <div class="field">
            <label>What's in the bottle?</label>
            <div class="choice">
                <button type="button" class="@(milk == MilkKind.BreastMilk ? "on" : "")"
                        @onclick="() => milk = MilkKind.BreastMilk">Breast milk</button>
                <button type="button" class="@(milk == MilkKind.Formula ? "on" : "")"
                        @onclick="() => milk = MilkKind.Formula">Formula</button>
            </div>
        </div>

        @if (milk == MilkKind.BreastMilk)
        {
            @* Which bag it came from. Never guessed from the clock: a bottle given at night is
               made up from whichever bag was to hand, and only the person holding it knows. Left
               blank it is counted as unlabelled rather than assigned a side. *@
            <div class="field">
                <label>Which batch?</label>
                <div class="choice">
                    <button type="button" class="@(batch == MilkTime.Morning ? "on" : "")"
                            @onclick="() => batch = Toggle(MilkTime.Morning)">Morning milk</button>
                    <button type="button" class="@(batch == MilkTime.Night ? "on" : "")"
                            @onclick="() => batch = Toggle(MilkTime.Night)">Night milk</button>
                </div>
            </div>
        }

        <div class="field">
            <label for="amount">Amount (ml)</label>
            <input id="amount" type="number" inputmode="numeric" min="0" max="1000" step="5" @bind="amount" />
            <div class="amounts">
                @foreach (var preset in new[] { 20, 40, 60, 90, 120, 150 })
                {
                    <button type="button" class="chip @(amount == preset ? "on" : "")"
                            @onclick="() => amount = preset">@preset</button>
                }
            </div>
        </div>

        <div class="field">
            <label for="bottle-notes">Notes (optional)</label>
            <input id="bottle-notes" type="text" maxlength="500" @bind="notes" />
        </div>

        <div class="row-btns">
            <button type="button" class="btn" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
            <button type="button" class="btn primary" @onclick="Save">@(Finishing ? "Done" : "Save")</button>
        </div>

        @if (!Finishing)
        {
            @* The one-tap log above stays the quick way, because most of the time you are
               writing down a bottle rather than starting one — often one already half drunk.
               Timing it is the deliberate choice, so it sits below as its own thing. *@
            <button type="button" class="btn block subtle" @onclick="Start">
                Start timing instead
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Log it now, as a moment — or, when finishing, record what the timed feed was.</summary>
    [Parameter] public EventCallback<BottleEntry> OnSave { get; set; }

    /// <summary>Begin a timed feed with whatever is already known about it.</summary>
    [Parameter] public EventCallback<BottleEntry> OnStart { get; set; }

    /// <summary>
    /// True when this is the sheet shown after stopping the timer, which only confirms what was
    /// in the bottle — there is nothing left to start.
    /// </summary>
    [Parameter] public bool Finishing { get; set; }

    /// <summary>How long the feed took, said back to whoever is filling the amount in.</summary>
    [Parameter] public string? FinishHint { get; set; }

    [Parameter] public MilkKind InitialMilk { get; set; } = MilkKind.BreastMilk;
    [Parameter] public MilkTime? InitialBatch { get; set; }
    [Parameter] public int? InitialAmount { get; set; }
    [Parameter] public string? InitialNotes { get; set; }

    private MilkKind milk = MilkKind.BreastMilk;
    private MilkTime? batch;
    private int? amount;
    private string? notes;

    /// <summary>Tapping the chip already on clears it — optional means a way to un-choose.</summary>
    private MilkTime? Toggle(MilkTime tapped) => batch == tapped ? null : tapped;

    protected override void OnInitialized()
    {
        milk = InitialMilk;
        batch = InitialBatch;
        amount = InitialAmount;
        notes = InitialNotes;
    }

    private Task Save() => OnSave.InvokeAsync(Entry());

    private Task Start() => OnStart.InvokeAsync(Entry());

    private BottleEntry Entry() =>
        new(milk, amount, milk == MilkKind.BreastMilk ? batch : null,
            string.IsNullOrWhiteSpace(notes) ? null : notes.Trim());

    public record BottleEntry(MilkKind Milk, int? AmountMl, MilkTime? Batch, string? Notes);
}
