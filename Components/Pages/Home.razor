@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject EventService Events
@inject BabyService Babies
@inject ILogger<Home> Logger

<PageTitle>Baby Tracker</PageTitle>

@* Says, from the server, that this page still has a circuit. *@
<CircuitHeartbeat />

@if (canEdit)
{
    <div class="actions">
        @if (runningFeed is not null)
        {
            <button class="action breast running wide" @onclick="() => Stop(runningFeed)">
                <span class="ico"><Icon Name="breast" /></span>
                <span class="timer">@Display.Clock(DateTime.UtcNow - runningFeed.StartUtc)</span>
                <span>Tap to stop</span>
                <span class="hint">started @Display.ToLocal(runningFeed.StartUtc).ToString("HH:mm")</span>
            </button>
        }
        else
        {
            <button class="action breast wide" @onclick="() => Start(EventKind.BreastFeed)">
                <span class="ico"><Icon Name="breast" /></span>
                <span>Start breast feed</span>
                <span class="hint">@LastHint(EventKind.BreastFeed)</span>
            </button>
        }

        @if (runningSleep is not null)
        {
            <button class="action sleep running wide" @onclick="() => Stop(runningSleep)">
                <span class="ico"><Icon Name="sleep" /></span>
                <span class="timer">@Display.Clock(DateTime.UtcNow - runningSleep.StartUtc)</span>
                <span>Tap to wake</span>
                <span class="hint">asleep since @Display.ToLocal(runningSleep.StartUtc).ToString("HH:mm")</span>
            </button>
        }
        else
        {
            <button class="action sleep wide" @onclick="() => Start(EventKind.Sleep)">
                <span class="ico"><Icon Name="sleep" /></span>
                <span>Start sleep</span>
                <span class="hint">@LastHint(EventKind.Sleep)</span>
            </button>
        }

        <button class="action bottle" @onclick="() => showBottle = true">
            <span class="ico"><Icon Name="bottle" /></span>
            <span>Bottle</span>
            <span class="hint">@LastHint(EventKind.BottleFeed)</span>
        </button>

        <button class="action poop" @onclick="() => Log(EventKind.Poop)">
            <span class="ico"><Icon Name="poop" /></span>
            <span>Poop</span>
            <span class="hint">@LastHint(EventKind.Poop)</span>
        </button>

        <button class="action urine" @onclick="() => Log(EventKind.Urine)">
            <span class="ico"><Icon Name="urine" /></span>
            <span>Urine</span>
            <span class="hint">@LastHint(EventKind.Urine)</span>
        </button>

        <button class="action vomit" @onclick="() => Log(EventKind.Vomit)">
            <span class="ico"><Icon Name="vomit" /></span>
            <span>Vomit</span>
            <span class="hint">@LastHint(EventKind.Vomit)</span>
        </button>
    </div>

    @foreach (var session in Running)
    {
        <button class="btn block subtle" @key="session.Id" @onclick="() => editing = session">
            @Display.Label(session) started at @Display.ToLocal(session.StartUtc).ToString("HH:mm") — adjust
        </button>
    }
}
else
{
    <div class="notice">
        Read-only access: entries can be seen here and on the
        <a href="chart">chart</a> and <a href="report">report</a>, but not changed.
    </div>

    @foreach (var session in Running)
    {
        <div class="card running-note" @key="session.Id">
            <span class="ico @Display.Css(session.Kind)"><Icon Name="@Icon.For(session.Kind)" /></span>
            @Display.Label(session) running since @Display.ToLocal(session.StartUtc).ToString("HH:mm")
            · @Display.Clock(DateTime.UtcNow - session.StartUtc)
        </div>
    }
}

<div class="section-title">
    <span>Recent</span>
    <a href="report">See report</a>
</div>

<div class="card">
    <EventList Events="recent" CanEdit="canEdit" OnEdit="e => editing = e"
               EmptyText="@(canEdit ? "Tap a button above to log the first entry." : "Nothing logged yet.")" />
</div>

@if (canEdit)
{
    <button class="btn block subtle" @onclick="AddEarlier">+ Add an entry from earlier</button>
}

@if (showBottle)
{
    <BottleDialog OnCancel="() => showBottle = false" OnSave="SaveBottle" />
}

@if (editing is not null)
{
    <EditEventDialog Event="editing" CanEdit="canEdit" OnCancel="() => editing = null" OnSave="SaveEdit" OnDelete="DeleteEvent" />
}

@if (toastUntil > DateTime.UtcNow)
{
    <div class="toast">@toast</div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool canEdit;
    private Baby? baby;
    private List<BabyEvent> recent = [];

    // A feed and a sleep run independently of each other, so each is tracked on its own.
    private BabyEvent? runningFeed;
    private BabyEvent? runningSleep;

    private IEnumerable<BabyEvent> Running =>
        new[] { runningFeed, runningSleep }.Where(e => e is not null)!;
    private BabyEvent? editing;
    private bool showBottle;

    private string? toast;
    private DateTime toastUntil = DateTime.MinValue;

    private CancellationTokenSource? ticker;

    protected override async Task OnInitializedAsync()
    {
        canEdit = await Access.CanEditAsync(AuthState);
        baby = await Babies.SelectedAsync(AuthState);
        await Reload();
        Events.Changed += OnEventsChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && ticker is null)
        {
            ticker = new CancellationTokenSource();
            _ = TickAsync(ticker.Token);
        }
    }

    /// <summary>
    /// Keeps the running timer and the "x minutes ago" hints moving. Ticks every second only while a
    /// feed is actually running, otherwise once every 30 seconds to keep the circuit chatter low.
    /// </summary>
    private async Task TickAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                var interval = runningFeed is not null || runningSleep is not null || toastUntil > DateTime.UtcNow
                    ? TimeSpan.FromSeconds(1)
                    : TimeSpan.FromSeconds(30);

                await Task.Delay(interval, ct);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnEventsChanged(int babyId)
    {
        // Somebody logging something for the other baby is nothing to do with this page.
        if (babyId != baby?.Id)
        {
            return;
        }

        _ = InvokeAsync(async () =>
    {
        try
        {
            await Reload();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // This runs because somebody else logged something, not because of anything done
            // here, and an exception escaping it would take this page's circuit down with the
            // error bar. The next change, or the reload button, will put the page right.
            Logger.LogError(ex, "Refreshing after a change to the event log failed.");
        }
        });
    }

    private async Task Reload()
    {
        if (baby is null)
        {
            return;
        }

        recent = await Events.GetRecentAsync(baby.Id, 12);

        // A session that started before the last twelve entries is still running, so fall back
        // to asking for it rather than deciding it does not exist.
        runningFeed = recent.FirstOrDefault(e => e.IsRunning && e.Kind == EventKind.BreastFeed)
            ?? await Events.GetRunningAsync(baby.Id, EventKind.BreastFeed);
        runningSleep = recent.FirstOrDefault(e => e.IsRunning && e.Kind == EventKind.Sleep)
            ?? await Events.GetRunningAsync(baby.Id, EventKind.Sleep);
    }

    private string LastHint(EventKind kind)
    {
        var last = recent.FirstOrDefault(e => e.Kind == kind && !e.IsRunning);
        return last is null ? "no entry yet" : $"last {Display.Ago(last.EndUtc ?? last.StartUtc)}";
    }

    private async Task Start(EventKind kind)
    {
        if (!canEdit || baby is null)
        {
            return;
        }

        await Events.StartAsync(baby.Id, kind);
        Toast(kind == EventKind.Sleep ? "Sleep started" : "Breast feed started");
    }

    private async Task Stop(BabyEvent? session)
    {
        if (session is null || !canEdit)
        {
            return;
        }

        var elapsed = DateTime.UtcNow - session.StartUtc;
        await Events.StopAsync(session.Id);
        Toast($"{Display.Label(session)} · {Display.Duration(elapsed)}");
    }

    private async Task Log(EventKind kind)
    {
        if (!canEdit || baby is null)
        {
            return;
        }

        await Events.LogAsync(baby!.Id, kind);
        Toast($"{Display.Label(kind)} logged");
    }

    private async Task SaveBottle(BottleDialog.BottleEntry entry)
    {
        showBottle = false;

        if (!canEdit || baby is null)
        {
            return;
        }

        await Events.LogBottleAsync(baby!.Id, entry.Milk, entry.AmountMl, entry.Notes);
        Toast(entry.AmountMl is > 0 ? $"Bottle · {entry.AmountMl} ml" : "Bottle logged");
    }

    /// <summary>Opens the editor on a blank entry, pre-filled as a feed that just finished.</summary>
    private void AddEarlier() => editing = new BabyEvent
    {
        BabyId = baby?.Id ?? 0,
        Kind = EventKind.BreastFeed,
        StartUtc = DateTime.UtcNow.AddMinutes(-15),
        EndUtc = DateTime.UtcNow
    };

    private async Task SaveEdit(BabyEvent updated)
    {
        editing = null;

        // A new entry carries the baby it belongs to; without one it would have nothing to
        // point at. Cannot happen through the UI, but a foreign key violation here would show
        // as the error bar rather than anything useful.
        if (!canEdit || baby is null)
        {
            return;
        }

        if (updated.Id == 0)
        {
            await Events.AddAsync(updated);
            Toast("Added");
            return;
        }

        await Events.UpdateAsync(updated);
        Toast("Saved");
    }

    private async Task DeleteEvent(int id)
    {
        editing = null;

        if (!canEdit)
        {
            return;
        }

        await Events.DeleteAsync(id);
        Toast("Deleted");
    }

    private void Toast(string message)
    {
        toast = message;
        toastUntil = DateTime.UtcNow.AddSeconds(2.5);
    }

    public async ValueTask DisposeAsync()
    {
        Events.Changed -= OnEventsChanged;

        if (ticker is not null)
        {
            await ticker.CancelAsync();
            ticker.Dispose();
            ticker = null;
        }
    }
}
