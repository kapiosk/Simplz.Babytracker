@page "/report"
@rendermode InteractiveServer
@implements IDisposable
@inject EventService Events
@inject PumpService Pumping
@inject BabyService Babies
@inject ILogger<Report> Logger

<PageTitle>Report · Baby Tracker</PageTitle>

@* Says, from the server, that this page still has a circuit. *@
<CircuitHeartbeat />

<h1>Report</h1>

<RangePicker DefaultDays="1" OnChanged="OnRange" />

<div class="stats">
    <div class="stat breast">
        <div class="k"><Icon Name="breast" /> Breast feeds</div>
        <div class="v">@breastCount</div>
        <div class="x">@(breastTotal > TimeSpan.Zero ? $"{Display.Duration(breastTotal)} total · {Display.Duration(breastAvg)} avg" : "no completed sessions")</div>
    </div>
    <div class="stat sleep">
        <div class="k"><Icon Name="sleep" /> Sleep</div>
        <div class="v">@Display.Duration(sleepTotal)</div>
        <div class="x">@(sleepCount > 0 ? $"{sleepCount} {(sleepCount == 1 ? "sleep" : "sleeps")} · longest {Display.Duration(sleepLongest)}" : "nothing recorded")</div>
    </div>
    <div class="stat bottle">
        <div class="k"><Icon Name="bottle" /> Bottles</div>
        <div class="v">@bottleCount</div>
        <div class="x">
            @bottleMl ml@(bottleTotal > TimeSpan.Zero ? $" · {Display.Duration(bottleTotal)} total" : "")
        </div>
        <div class="x">@formulaCount formula / @breastMilkCount breast milk</div>
    </div>
    <div class="stat poop">
        <div class="k"><Icon Name="poop" /> Poops</div>
        <div class="v">@Count(EventKind.Poop)</div>
        <div class="x">@PerDay(Count(EventKind.Poop))@(Diarrhoea > 0 ? $" · {Diarrhoea} diarrhoea" : "")</div>
    </div>
    <div class="stat urine">
        <div class="k"><Icon Name="urine" /> Urine</div>
        <div class="v">@Count(EventKind.Urine)</div>
        <div class="x">@PerDay(Count(EventKind.Urine))</div>
    </div>
    <div class="stat spitup">
        <div class="k"><Icon Name="spitup" /> Spit-ups</div>
        <div class="v">@Count(EventKind.SpitUp)</div>
        <div class="x">@PerDay(Count(EventKind.SpitUp))</div>
    </div>

    @* Only when there were any. A tile reading 0 every ordinary week says nothing, and its
       appearing at all is the signal on the week that has them. *@
    @if (Count(EventKind.Vomit) > 0)
    {
        <div class="stat vomit">
            <div class="k"><Icon Name="vomit" /> Vomits</div>
            <div class="v">@Count(EventKind.Vomit)</div>
            <div class="x">@PerDay(Count(EventKind.Vomit))</div>
        </div>
    }

    @* Last of the tiles on purpose: everything above it is about the baby, and this one is not.
       It borrows the breast colour, as pumping does everywhere else in the app. *@
    <div class="stat breast">
        <div class="k"><Icon Name="pump" /> Pumping</div>
        @* The unit rides with the figure, the way Sleep shows "10h 20m" — splitting it left the
           tile reading "330" over "ml · 2h 28m total", which parses as neither one thing nor two. *@
        <div class="v">@pumpedMl ml</div>
        <div class="x">
            @(pumpCount > 0
                ? $"{pumpCount} {(pumpCount == 1 ? "session" : "sessions")} · {Display.Duration(pumpTotal)} total"
                : "no completed sessions")
        </div>
    </div>
</div>

@if (days.Count > 1)
{
    <div class="section-title"><span>Day by day</span></div>
    <div class="card scroll-x">
        <table class="grid">
            <thead>
                <tr>
                    <th>Day</th>
                    <th class="breast"><Icon Name="breast" /></th>
                    <th>Time</th>
                    <th class="sleep"><Icon Name="sleep" /></th>
                    <th class="bottle"><Icon Name="bottle" /></th>
                    <th>ml</th>
                    <th>Time</th>
                    <th class="poop"><Icon Name="poop" /></th>
                    <th class="urine"><Icon Name="urine" /></th>
                    <th class="spitup"><Icon Name="spitup" /></th>
                    @* The same order as the tiles above, pumping last for the same reason. *@
                    <th class="breast"><Icon Name="pump" /></th>
                    <th>ml</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in days)
                {
                    <tr>
                        <td>@day.Date.ToString("ddd d MMM")</td>
                        <td>@Num(day.Breast)</td>
                        <td>@(day.BreastTime > TimeSpan.Zero ? Display.Duration(day.BreastTime) : "–")</td>
                        <td>@(day.Sleep > TimeSpan.Zero ? Display.Duration(day.Sleep) : "–")</td>
                        <td>@Num(day.Bottle)</td>
                        <td>@(day.Ml > 0 ? day.Ml.ToString() : "–")</td>
                        <td>@(day.BottleTime > TimeSpan.Zero ? Display.Duration(day.BottleTime) : "–")</td>
                        <td>@Num(day.Poop)</td>
                        <td>@Num(day.Urine)</td>
                        <td>@Num(day.SpitUp)</td>
                        <td>@Num(day.Pumps)</td>
                        <td>@(day.PumpMl > 0 ? day.PumpMl.ToString() : "–")</td>
                        <td>@(day.PumpTime > TimeSpan.Zero ? Display.Duration(day.PumpTime) : "–")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="section-title">
    <span>All entries (@events.Count)</span>
</div>

<div class="card">
    <EventList Events="listed" ShowDate="true" CanEdit="canEdit" OnEdit="e => editing = e"
               EmptyText="Nothing logged in this range." />
    @if (events.Count > listed.Count)
    {
        <div class="empty">Showing the @listed.Count most recent of @events.Count entries — narrow the range to see the rest.</div>
    }
</div>

@if (canEdit)
{
    <button class="btn block subtle" @onclick="AddEarlier">+ Add an entry from earlier</button>
}

@* After the baby's entries, as the tile is after the baby's tiles. Each session with when it
   was, how long it ran and what came out — the tile's total, opened out. *@
<div class="section-title">
    <span>Pumping sessions (@pumps.Count)</span>
</div>

<div class="card">
    <PumpList Entries="pumps" ShowDate="true" CanEdit="canEdit" OnEdit="e => editingPump = e"
              EmptyText="No sessions in this range." />
</div>

@if (editing is not null)
{
    <EditEventDialog Event="editing" CanEdit="canEdit" OnCancel="() => editing = null" OnSave="SaveEdit" OnDelete="DeleteEvent" />
}

@if (editingPump is not null)
{
    <PumpEntryDialog Entry="editingPump" OnCancel="() => editingPump = null" OnSave="SavePump" OnDelete="DeletePump" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool canEdit;
    private Baby? baby;
    private DateTime fromDate = DateTime.Now.Date;
    private DateTime toDate = DateTime.Now.Date;

    private const int MaxListed = 100;

    private List<BabyEvent> events = [];
    private List<BabyEvent> listed = [];
    private List<DayRow> days = [];
    private BabyEvent? editing;

    /// <summary>The finished sessions in the range, newest first. What the tile adds up.</summary>
    private List<PumpEntry> pumps = [];
    private PumpEntry? editingPump;

    private int breastCount;
    private TimeSpan breastTotal;
    private TimeSpan breastAvg;
    private int sleepCount;
    private TimeSpan sleepTotal;
    private TimeSpan sleepLongest;
    private int bottleCount;
    private int bottleMl;
    private TimeSpan bottleTotal;
    private int pumpCount;
    private int pumpedMl;
    private TimeSpan pumpTotal;
    private int formulaCount;
    private int breastMilkCount;

    protected override async Task OnInitializedAsync()
    {
        canEdit = await Access.CanEditAsync(AuthState);
        baby = await Babies.SelectedAsync(AuthState);
        Events.Changed += OnEventsChanged;

        // Pumping never goes through EventService, so without this the pumping tile would sit
        // stale while every other figure on the page refreshed.
        Pumping.Changed += OnEventsChanged;
    }

    private async Task OnRange(RangePicker.Selection range)
    {
        (fromDate, toDate) = (range.From, range.To);
        await Reload();
    }

    private async Task Reload()
    {
        if (baby is null)
        {
            return;
        }

        var fromUtc = Display.ToUtc(fromDate);
        var toUtc = Display.ToUtc(toDate.AddDays(1));

        events = await Events.GetRangeAsync(baby.Id, fromUtc, toUtc);

        listed = events.Take(MaxListed).ToList();

        var breastFeeds = events.Where(e => e.Kind == EventKind.BreastFeed).ToList();
        breastCount = breastFeeds.Count;
        var completed = breastFeeds.Where(e => e.Duration is not null).ToList();
        breastTotal = completed.Aggregate(TimeSpan.Zero, (sum, e) => sum + e.Duration!.Value);
        breastAvg = completed.Count > 0 ? breastTotal / completed.Count : TimeSpan.Zero;

        // Only finished sleeps count: one still running has no length yet.
        var sleeps = events
            .Where(e => e.Kind == EventKind.Sleep && e.Duration is not null)
            .ToList();
        sleepCount = sleeps.Count;
        sleepTotal = sleeps.Aggregate(TimeSpan.Zero, (sum, e) => sum + e.Duration!.Value);
        sleepLongest = sleeps.Count > 0 ? sleeps.Max(e => e.Duration!.Value) : TimeSpan.Zero;

        var bottles = events.Where(e => e.Kind == EventKind.BottleFeed).ToList();
        bottleCount = bottles.Count;
        bottleMl = bottles.Sum(e => e.AmountMl ?? 0);

        // Only the timed ones have a length. A bottle logged in one tap ends where it starts,
        // so it contributes nothing here rather than a zero that drags an average down.
        bottleTotal = bottles.Aggregate(TimeSpan.Zero, (sum, e) => sum + (e.Duration ?? TimeSpan.Zero));
        formulaCount = bottles.Count(e => e.Milk == MilkKind.Formula);
        breastMilkCount = bottles.Count(e => e.Milk == MilkKind.BreastMilk);

        // Sessions only, and only finished ones — a stock correction carries millilitres too,
        // but that figure is what the fridge holds rather than what came out of anybody.
        pumps = (await Pumping.GetRangeAsync(baby.Id, fromUtc, toUtc))
            .Where(e => e.Kind == PumpEntryKind.Session && e.EndUtc is not null)
            .ToList();
        pumpCount = pumps.Count;
        pumpedMl = pumps.Sum(e => e.AmountMl ?? 0);
        pumpTotal = pumps.Aggregate(TimeSpan.Zero, (sum, e) => sum + (e.Duration ?? TimeSpan.Zero));

        // Every day in the range gets a row, including the quiet ones.
        var byDay = events.GroupBy(e => Display.ToLocal(e.StartUtc).Date)
            .ToDictionary(g => g.Key, g => g.ToList());
        var pumpsByDay = pumps.GroupBy(e => Display.ToLocal(e.StartUtc).Date)
            .ToDictionary(g => g.Key, g => g.ToList());

        days = [];
        for (var day = toDate; day >= fromDate; day = day.AddDays(-1))
        {
            var entries = byDay.TryGetValue(day, out var list) ? list : [];
            var sessions = pumpsByDay.TryGetValue(day, out var pumped) ? pumped : [];
            days.Add(new DayRow(
                day,
                entries.Count(e => e.Kind == EventKind.BreastFeed),
                entries.Where(e => e.Kind == EventKind.BreastFeed && e.Duration is not null)
                       .Aggregate(TimeSpan.Zero, (sum, e) => sum + e.Duration!.Value),

                // A sleep counts on the day it began, the whole of it, as the tile counts it.
                entries.Where(e => e.Kind == EventKind.Sleep && e.Duration is not null)
                       .Aggregate(TimeSpan.Zero, (sum, e) => sum + e.Duration!.Value),
                entries.Count(e => e.Kind == EventKind.BottleFeed),
                entries.Where(e => e.Kind == EventKind.BottleFeed).Sum(e => e.AmountMl ?? 0),
                entries.Where(e => e.Kind == EventKind.BottleFeed)
                       .Aggregate(TimeSpan.Zero, (sum, e) => sum + (e.Duration ?? TimeSpan.Zero)),
                entries.Count(e => e.Kind == EventKind.Poop),
                entries.Count(e => e.Kind == EventKind.Urine),
                entries.Count(e => e.Kind == EventKind.SpitUp),
                sessions.Count,
                sessions.Sum(e => e.AmountMl ?? 0),
                sessions.Aggregate(TimeSpan.Zero, (sum, e) => sum + (e.Duration ?? TimeSpan.Zero))));
        }
    }

    private int Count(EventKind kind) => events.Count(e => e.Kind == kind);

    /// <summary>Counted among the poops, and said beside them — see the Health page.</summary>
    private int Diarrhoea => events.Count(e => e.Kind == EventKind.Poop && e.Diarrhoea);

    private static string Num(int value) => value == 0 ? "–" : value.ToString();

    private string PerDay(int count)
    {
        var spanDays = Math.Max(1, (toDate - fromDate).Days + 1);
        return spanDays == 1 ? "today" : $"{(double)count / spanDays:0.#} per day";
    }

    private void OnEventsChanged(int babyId)
    {
        // Somebody logging something for the other baby is nothing to do with this page.
        if (babyId != baby?.Id)
        {
            return;
        }

        _ = InvokeAsync(async () =>
    {
        try
        {
            await Reload();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // This runs because somebody else logged something, not because of anything done
            // here, and an exception escaping it would take this page's circuit down with the
            // error bar. The next change, or the reload button, will put the page right.
            Logger.LogError(ex, "Refreshing after a change to the event log failed.");
        }
        });
    }

    private void AddEarlier() => editing = new BabyEvent
    {
        BabyId = baby?.Id ?? 0,
        Kind = EventKind.BreastFeed,
        StartUtc = DateTime.UtcNow.AddMinutes(-15),
        EndUtc = DateTime.UtcNow
    };

    private async Task SaveEdit(BabyEvent updated)
    {
        editing = null;

        // A new entry carries the baby it belongs to; without one it would have nothing to
        // point at. Cannot happen through the UI, but a foreign key violation here would show
        // as the error bar rather than anything useful.
        if (!canEdit || baby is null)
        {
            return;
        }

        if (updated.Id == 0)
        {
            await Events.AddAsync(updated);
            return;
        }

        await Events.UpdateAsync(updated);
    }

    private async Task DeleteEvent(int id)
    {
        editing = null;

        if (!canEdit)
        {
            return;
        }

        await Events.DeleteAsync(id);
    }

    private async Task SavePump(PumpEntry updated)
    {
        editingPump = null;

        if (!canEdit)
        {
            return;
        }

        await Pumping.UpdateAsync(updated);
    }

    private async Task DeletePump(int id)
    {
        editingPump = null;

        if (!canEdit)
        {
            return;
        }

        await Pumping.DeleteAsync(id);
    }

    public void Dispose()
    {
        Events.Changed -= OnEventsChanged;

        // Both, or the page is held alive by the singleton it is still subscribed to and goes
        // on being told about changes long after its circuit has gone.
        Pumping.Changed -= OnEventsChanged;
    }

    private record DayRow(
        DateTime Date, int Breast, TimeSpan BreastTime, TimeSpan Sleep,
        int Bottle, int Ml, TimeSpan BottleTime,
        int Poop, int Urine, int SpitUp,
        int Pumps, int PumpMl, TimeSpan PumpTime);
}
