@page "/password"
@rendermode InteractiveServer
@inject Credentials Credentials
@inject NavigationManager Nav

<PageTitle>Passwords · Baby Tracker</PageTitle>

<h1>Passwords</h1>

@if (!canEdit)
{
    <p class="login-note" style="margin-top:0">
        Only the parent password can change these.
    </p>
}
else
{
    <p class="login-note" style="margin-top:0">
        These replace the ones the container was started with. Leave a box empty to keep that
        password as it is. Changing a password does not sign anyone out — the phones already
        signed in stay signed in until you ask for otherwise below.
    </p>

    @if (error is not null)
    {
        <p class="login-error">@error</p>
    }

    @if (done is not null)
    {
        <p class="login-note" style="color:var(--vomit);font-weight:600">@done</p>
    }

    <div class="card">
        <div class="field">
            <label for="current">Current parent password</label>
            <input id="current" type="password" autocomplete="current-password" @bind="current" />
        </div>
    </div>

    <div class="card">
        <div class="field">
            <label for="parent1">New parent password</label>
            <input id="parent1" type="password" autocomplete="new-password" @bind="parent1" />
        </div>
        <div class="field" style="margin-bottom:0">
            <label for="parent2">Repeat it</label>
            <input id="parent2" type="password" autocomplete="new-password" @bind="parent2" />
        </div>
        <div class="hint-line">@Where(Credentials.ParentKey)</div>
    </div>

    <div class="card">
        <div class="field">
            <label for="doctor1">New doctor password</label>
            <input id="doctor1" type="password" autocomplete="new-password" @bind="doctor1" />
        </div>
        <div class="field" style="margin-bottom:0">
            <label for="doctor2">Repeat it</label>
            <input id="doctor2" type="password" autocomplete="new-password" @bind="doctor2" />
        </div>
        <div class="hint-line">@Where(Credentials.DoctorKey)</div>
    </div>

    <div class="card">
        <label class="check">
            <input type="checkbox" @bind="signOutEverywhere" />
            <span>
                Sign out every device, including this one. Use this if a password is being
                changed because somebody has it who should not — otherwise a phone that is
                already signed in stays signed in for months whatever the password becomes.
            </span>
        </label>
    </div>

    <button class="btn block" disabled="@busy" @onclick="Save">Save</button>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool canEdit;
    private bool busy;

    private string current = "";
    private string parent1 = "";
    private string parent2 = "";
    private string doctor1 = "";
    private string doctor2 = "";
    private bool signOutEverywhere;

    private string? error;
    private string? done;

    private bool parentChanged;
    private bool doctorChanged;

    private const int Shortest = 4;

    protected override async Task OnInitializedAsync()
    {
        canEdit = await Access.CanEditAsync(AuthState);
        parentChanged = await Credentials.IsChangedAsync(Credentials.ParentKey);
        doctorChanged = await Credentials.IsChangedAsync(Credentials.DoctorKey);
    }

    private string Where(string key) =>
        (key == Credentials.ParentKey ? parentChanged : doctorChanged)
            ? "Currently set here."
            : "Currently the one from compose.yaml.";

    private async Task Save()
    {
        error = null;
        done = null;

        var newParent = parent1.Trim();
        var newDoctor = doctor1.Trim();

        if (newParent.Length == 0 && newDoctor.Length == 0 && !signOutEverywhere)
        {
            error = "Nothing to change.";
            return;
        }

        if (newParent.Length > 0 && newParent != parent2.Trim())
        {
            error = "The two parent passwords don't match.";
            return;
        }

        if (newDoctor.Length > 0 && newDoctor != doctor2.Trim())
        {
            error = "The two doctor passwords don't match.";
            return;
        }

        if ((newParent.Length > 0 && newParent.Length < Shortest)
            || (newDoctor.Length > 0 && newDoctor.Length < Shortest))
        {
            error = $"A password needs at least {Shortest} characters.";
            return;
        }

        busy = true;
        try
        {
            // The current password rather than only the role, so an unlocked phone left on a
            // table is not enough on its own to lock everybody else out.
            if (await Credentials.RoleForAsync(current) != Roles.Parent)
            {
                await Task.Delay(TimeSpan.FromMilliseconds(750));
                error = "That current password doesn't match.";
                return;
            }

            if (newParent.Length > 0)
            {
                await Credentials.SetPasswordAsync(Credentials.ParentKey, newParent);
            }

            if (newDoctor.Length > 0)
            {
                await Credentials.SetPasswordAsync(Credentials.DoctorKey, newDoctor);
            }

            if (signOutEverywhere)
            {
                // This cookie goes with the rest, so there is nowhere to go but the sign-in page.
                await Credentials.SignOutEverywhereAsync();
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }

            current = parent1 = parent2 = doctor1 = doctor2 = "";
            parentChanged = await Credentials.IsChangedAsync(Credentials.ParentKey);
            doctorChanged = await Credentials.IsChangedAsync(Credentials.DoctorKey);
            done = "Saved. Everyone stays signed in; the new password is what the next sign-in asks for.";
        }
        finally
        {
            busy = false;
        }
    }
}
