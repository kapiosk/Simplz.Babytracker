@page "/trends"
@rendermode InteractiveServer
@implements IDisposable
@inject EventService Events
@inject PumpService Pumping
@inject BabyService Babies
@inject ILogger<Trends> Logger

<PageTitle>Trends · Baby Tracker</PageTitle>

@* Says, from the server, that this page still has a circuit. *@
<CircuitHeartbeat />

<h1>Trends</h1>

<RangePicker DefaultDays="7" OnChanged="OnRange" />

@* One bar a day over a range, and one bar an hour when the range is a single day — a chart of
   thirty days has a shape worth seeing, and a chart of one day has exactly one bar and says
   nothing. Same chart either way; only what a bar covers changes. *@
<BarChart Label="Sleep" Css="sleep" IconName="sleep" Bucket="@bucket"
          Total="@Minutes(sleep.Sum(p => p.Value))" Points="sleep" />

<BarChart Label="Breast feeds" Css="breast" IconName="breast" Bucket="@bucket"
          Total="@($"{(int)feeds.Sum(p => p.Value)}")" Points="feeds" />

@* Bottles and pumping each get two charts, how much and how long, and they are deliberately
   adjacent and the same colour. Seven charts is more than this page was built for — five was
   already the point at which I said it would want rethinking rather than appending to — and
   pairing them is what stops it reading as an undifferentiated stack: the colour here groups
   the two questions about one subject rather than telling subjects apart. *@
<BarChart Label="Bottles" Css="bottle" IconName="bottle" Bucket="@bucket"
          Total="@($"{(int)bottles.Sum(p => p.Value)} ml")" Points="bottles" />

<BarChart Label="Time on bottles" Css="bottle" IconName="timer" Bucket="@bucket"
          Total="@Minutes(bottleTime.Sum(p => p.Value))" Points="bottleTime" />

@* Pumping shares the breast colour, because pumped milk is breast milk and because nothing else
   was available: measured against the four already on this page, every distinct candidate ran
   into one of them — teals into the bottle blue and into the breast pink for a deuteranope,
   violets into the sleep indigo, oranges into the poop brown. Four kind colours is what this
   palette holds. It is harmless here because every chart is titled and iconed and carries one
   series, so colour has never been what tells them apart. *@
<BarChart Label="Pumped" Css="breast" IconName="pump" Bucket="@bucket"
          Total="@($"{(int)pumped.Sum(p => p.Value)} ml")" Points="pumped" />

<BarChart Label="Time pumping" Css="breast" IconName="timer" Bucket="@bucket"
          Total="@Minutes(pumpTime.Sum(p => p.Value))" Points="pumpTime" />

<BarChart Label="Poops" Css="poop" IconName="poop" Bucket="@bucket"
          Total="@($"{(int)poops.Sum(p => p.Value)}")" Points="poops" />

<p class="login-note">
    @if (EveryBarLabelled)
    {
        <text>Each bar carries its own figure.</text>
    }
    else
    {
        <text>
            Too many bars to label, so the tallest carries a figure and
            <em>every @bucket</em> under a chart opens the rest.
        </text>
    }
    The number beside a title is the whole range.
    <NavLink href="report">The report</NavLink> has every entry behind these.
</p>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Baby? baby;
    private DateTime fromDate = DateTime.Now.Date;
    private DateTime toDate = DateTime.Now.Date;

    private string bucket = "day";

    /// <summary>
    /// Whether the charts had room to label every bar, so the note underneath says which of the
    /// two things the reader is actually looking at. Every chart holds the same buckets, so
    /// asking one of them answers for all.
    /// </summary>
    private bool EveryBarLabelled => sleep.Count is > 0 and <= BarChart.LabelEveryUpTo;

    private List<BarChart.Point> sleep = [];
    private List<BarChart.Point> feeds = [];
    private List<BarChart.Point> bottles = [];
    private List<BarChart.Point> bottleTime = [];
    private List<BarChart.Point> pumped = [];
    private List<BarChart.Point> pumpTime = [];
    private List<BarChart.Point> poops = [];

    protected override async Task OnInitializedAsync()
    {
        baby = await Babies.SelectedAsync(AuthState);
        Events.Changed += OnEventsChanged;

        // Pumping is logged on its own page and does not go through EventService at all, so
        // without this its two charts would sit stale while the rest refreshed.
        Pumping.Changed += OnEventsChanged;
    }

    private async Task OnRange(RangePicker.Selection range)
    {
        (fromDate, toDate) = (range.From, range.To);
        await Reload();
    }

    private async Task Reload()
    {
        if (baby is null)
        {
            return;
        }

        var fromUtc = Display.ToUtc(fromDate);
        var toUtc = Display.ToUtc(toDate.AddDays(1));

        var events = await Events.GetRangeAsync(baby.Id, fromUtc, toUtc);
        var pumps = await Pumping.GetRangeAsync(baby.Id, fromUtc, toUtc);

        if (fromDate == toDate)
        {
            BuildByHour(events, pumps);
        }
        else
        {
            BuildByDay(events, pumps);
        }
    }

    private void BuildByDay(List<BabyEvent> events, List<PumpEntry> pumps)
    {
        bucket = "day";

        var days = new List<DateTime>();
        for (var day = fromDate; day <= toDate; day = day.AddDays(1))
        {
            days.Add(day);
        }

        // Grouped by the day a thing started, which is how the report counts it too. A sleep that
        // runs past midnight belongs to the evening it began, and the two pages agreeing matters
        // more than splitting it across both.
        var byDay = events.GroupBy(e => Display.ToLocal(e.StartUtc).Date)
            .ToDictionary(g => g.Key, g => g.ToList());

        var pumpsByDay = pumps.GroupBy(e => Display.ToLocal(e.StartUtc).Date)
            .ToDictionary(g => g.Key, g => g.ToList());

        Build(days,
            day => byDay.TryGetValue(day, out var list) ? list : [],
            day => pumpsByDay.TryGetValue(day, out var list) ? list : [],
            day => Label(day, days.Count));
    }

    private void BuildByHour(List<BabyEvent> events, List<PumpEntry> pumps)
    {
        bucket = "hour";

        var hours = Enumerable.Range(0, 24).ToList();

        var byHour = events.GroupBy(e => Display.ToLocal(e.StartUtc).Hour)
            .ToDictionary(g => g.Key, g => g.ToList());

        var pumpsByHour = pumps.GroupBy(e => Display.ToLocal(e.StartUtc).Hour)
            .ToDictionary(g => g.Key, g => g.ToList());

        Build(hours,
            hour => byHour.TryGetValue(hour, out var list) ? list : [],
            hour => pumpsByHour.TryGetValue(hour, out var list) ? list : [],
            hour => $"{hour:00}:00");
    }

    private void Build<T>(
        List<T> buckets,
        Func<T, List<BabyEvent>> entriesIn,
        Func<T, List<PumpEntry>> pumpsIn,
        Func<T, string> label)
    {
        sleep = [];
        feeds = [];
        bottles = [];
        bottleTime = [];
        pumped = [];
        pumpTime = [];
        poops = [];

        foreach (var slot in buckets)
        {
            var entries = entriesIn(slot);
            var name = label(slot);

            // Only finished sleeps have a length; one still running is not a number yet.
            var minutes = entries
                .Where(e => e.Kind == EventKind.Sleep && e.Duration is not null)
                .Sum(e => e.Duration!.Value.TotalMinutes);

            var feedCount = entries.Count(e => e.Kind == EventKind.BreastFeed);
            var ml = entries.Where(e => e.Kind == EventKind.BottleFeed).Sum(e => e.AmountMl ?? 0);

            // Only the timed bottles have a length. One logged in a single tap ends where it
            // starts, so it adds nothing here rather than a zero.
            var bottleMinutes = entries
                .Where(e => e.Kind == EventKind.BottleFeed)
                .Sum(e => (e.Duration ?? TimeSpan.Zero).TotalMinutes);
            var poopCount = entries.Count(e => e.Kind == EventKind.Poop);

            // Sessions only, and only finished ones. A stock correction also carries millilitres,
            // but that figure is what the fridge holds rather than what came out of anybody, and
            // adding it here would inflate the day it was made by the whole stock.
            var finishedPumps = pumpsIn(slot)
                .Where(e => e.Kind == PumpEntryKind.Session && e.EndUtc is not null)
                .ToList();
            var pumpedMl = finishedPumps.Sum(e => e.AmountMl ?? 0);
            var pumpMinutes = finishedPumps.Sum(e => (e.Duration ?? TimeSpan.Zero).TotalMinutes);

            // The second string is what fits under a bar: the unit dropped, because the chart
            // above it is already titled. Sleep needs its own shorter form — "12h 20m" is 41px
            // wide in a 42px column, which is not a margin worth trusting to another browser's
            // idea of the same font.
            sleep.Add(new BarChart.Point(name, minutes, Minutes(minutes),
                minutes >= 1 ? Display.Compact(TimeSpan.FromMinutes(minutes)) : null));
            feeds.Add(new BarChart.Point(name, feedCount, feedCount == 1 ? "1 feed" : $"{feedCount} feeds",
                $"{feedCount}"));
            bottles.Add(new BarChart.Point(name, ml, $"{ml} ml", $"{ml}"));
            pumped.Add(new BarChart.Point(name, pumpedMl, $"{pumpedMl} ml", $"{pumpedMl}"));

            bottleTime.Add(new BarChart.Point(name, bottleMinutes, Minutes(bottleMinutes),
                bottleMinutes >= 1 ? Display.Compact(TimeSpan.FromMinutes(bottleMinutes)) : null));
            pumpTime.Add(new BarChart.Point(name, pumpMinutes, Minutes(pumpMinutes),
                pumpMinutes >= 1 ? Display.Compact(TimeSpan.FromMinutes(pumpMinutes)) : null));
            poops.Add(new BarChart.Point(name, poopCount, $"{poopCount}"));
        }
    }

    /// <summary>
    /// A sleep of a few seconds is a mis-tap put right, and Display.Duration rounds it to "0m",
    /// which beside a drawn bar reads as something broken rather than as something brief.
    /// </summary>
    private static string Minutes(double minutes) =>
        minutes <= 0 ? "none"
            : minutes < 1 ? "under a minute"
            : Display.Duration(TimeSpan.FromMinutes(minutes));

    /// <summary>Short enough to fit under a bar: a weekday for a week, a date for a month.</summary>
    private static string Label(DateTime day, int span) =>
        span <= 7 ? day.ToString("ddd") : day.ToString("d MMM");

    private void OnEventsChanged(int babyId)
    {
        if (babyId != baby?.Id)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Reload();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Refreshing the trends after a change to the event log failed.");
            }
        });
    }

    public void Dispose()
    {
        Events.Changed -= OnEventsChanged;
        Pumping.Changed -= OnEventsChanged;
    }
}
